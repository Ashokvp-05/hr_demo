POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# REQUIRED — the app refuses to start without it (no insecure default).
# Use a long random string, e.g. `openssl rand -base64 48`. Min 32 chars.
JWT_SECRET=
AUTH_SECRET=
FRONTEND_URL=
BACKEND_URL=

# ── Seed account passwords (optional) ─────────────────────────────────────────
# Control seeded account passwords instead of committing them to source.
# Set a shared default, and/or per-account overrides. If none are set, the
# seed generates a strong random password and prints it once (rotate it).
SEED_DEFAULT_PASSWORD=
# SEED_PWD_VISWA=
# SEED_PWD_MARX=
# SEED_PWD_SAM=
# SEED_PWD_HR=
# SEED_PWD_MANAGER=
# SEED_PWD_EMPLOYEE=
# SEED_PWD_AUDITOR=
# SEED_PWD_SUPPORT=

# ── Rate limiting (optional overrides) ────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000     # global window (default 15 min)
# RATE_LIMIT_MAX=1000             # global max requests / window / IP
# AUTH_RATE_LIMIT_WINDOW_MS=900000 # auth window (default 15 min)
# AUTH_RATE_LIMIT_MAX=10          # max failed auth attempts / window / IP
